# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Both of these are PUBLIC by design -- EXPO_PUBLIC_* is compiled into the app
# bundle. They are safe to ship because RLS, not secrecy, protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NOTHING ELSE BELONGS IN THIS FILE.
#
# These are Edge Function secrets (supabase secrets set ...) and must never
# appear here or in any bundled file:
#   SUPABASE_SERVICE_ROLE_KEY   - bypasses RLS entirely
#   PIN_PEPPER                  - PIN derivation
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION / SES_*
